{
  "name": "@joseph-flinn/gawl",
  "version": "0.0.0",
  "description": "GitHub Actions Workflow Linter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joseph-flinn/github-actions-workflow-linter.git"
  },
  "author": "Joseph Flinn (https://github.com/joseph-flinn)",
  "license": "SEE LICENSE IN LICENSE.txt",
  "homepage": "https://github.com/joseph-flinn/github-actions-workflow-linter",
  "devDependencies": {
    "husky": "9.0.11",
    "lint-staged": "15.2.7",
    "prettier": "3.3.2"
  },
  "lint-staged": {
    "!(*.py)": "prettier --cache --write --ignore-unknown",
    "*.py": [
      "pipenv run black",
      "pipenv run pylint --rcfile pylintrc"
    ]
  },
  "scripts": {
    "prepare": "husky"
  }
}
